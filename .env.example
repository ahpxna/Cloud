# Copy to .env. Never commit credentials or tunnel tokens.
COMPOSE_PROJECT_NAME=family-photo-cloud

# Reviewed upstream versions. Production commissioning should replace these
# mutable tags with image@sha256 refs from `make resolve-image-digests`.
POSTGRES_IMAGE=postgres:18.6-alpine
TUSD_IMAGE=ghcr.io/tus/tusd:v2.10.1
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.9.3

POSTGRES_DB=photo_cloud
# Bootstrap/migration credential. Runtime services never use this superuser.
POSTGRES_USER=photo_cloud
POSTGRES_PASSWORD=replace-with-a-long-random-bootstrap-secret
# Independent non-superuser runtime credentials created by db-role-bootstrap.
GATEWAY_DB_PASSWORD=replace-with-a-different-long-random-gateway-secret
ADMIN_DB_PASSWORD=replace-with-a-different-long-random-admin-secret
INTEGRITY_DB_PASSWORD=replace-with-a-different-long-random-integrity-secret
READONLY_DB_PASSWORD=replace-with-a-different-long-random-readonly-secret
BACKUP_DB_PASSWORD=replace-with-a-different-long-random-backup-secret
SESSION_MAINTENANCE_DB_PASSWORD=replace-with-a-different-long-random-session-maintenance-secret
POSTGRES_PORT=5432

# The protocol lab binds to loopback only. It must never be exposed through a
# tunnel; it deliberately has no product authentication.
TUSD_DEV_PORT=1080
TUS_MAX_UPLOAD_BYTES=21474836480
TUS_MVP_CHUNK_BYTES=33554432

# `make secrets` fills every blank/placeholder secret below without printing it.
# Leave blank in the committed example. The gateway refuses to start without it.
ACCESS_TOKEN_HMAC_KEY_BASE64=
# Separate keys: do not reuse the access-token secret.
LOGIN_THROTTLE_HMAC_KEY_BASE64=
# Exactly 32 decoded bytes; generate each independently with: openssl rand -base64 32
MFA_ENCRYPTION_KEY_BASE64=
# Encrypts only the 7-day refresh-rotation retry capsule. Keep stable across
# gateway restarts and never reuse ACCESS_TOKEN_HMAC_KEY_BASE64 or the MFA key.
REFRESH_RETRY_ENCRYPTION_KEY_BASE64=
GLOBAL_LOGIN_RATE_PER_SECOND=1
GLOBAL_LOGIN_BURST=20
UPLOAD_SESSION_CREATE_WINDOW=1m
MAX_UPLOAD_SESSION_CREATES_PER_WINDOW=30
UPLOAD_GATEWAY_DEV_PORT=8081
VERIFICATION_WORKERS=2
MAX_CONCURRENT_PATCHES=6
MAX_PATCHES_PER_USER=2
# /readyz and new uploads require this much free space on the media volume.
# Keep 200 GiB in production; a laptop smoke test can lower it (e.g. 5 GiB).
PHOTO_MIN_FREE_BYTES=214748364800
RECONCILE_INTERVAL=1m
MAX_ACTIVE_UPLOAD_SESSIONS=200
VERIFICATION_LEASE=10m
# Leave empty for a fresh database. Only one-time upgrade from the old
# docker-entrypoint schema: set to the last independently verified version.
PHOTO_MIGRATION_BASELINE_VERSION=
HTTP_READ_TIMEOUT=20m
HTTP_WRITE_TIMEOUT=30m
HTTP_IDLE_TIMEOUT=2m
PHOTO_MEDIA_ROOT=/srv/media
# Set these to the owner of the Linux media directory (`id -u`, `id -g`).
PHOTO_UID=1000
PHOTO_GID=1000

# Reserved for the authenticated MVP edge profile. Keep blank in local dev.
CLOUDFLARE_TUNNEL_TOKEN=

# Private Tailscale ingress (`make tailnet-up`), the free alternative to a
# domain + Cloudflare. Create a one-time auth key in the Tailscale admin console;
# it is only needed for the first start (state then lives in .data/tailscale).
TAILSCALE_AUTHKEY=
TAILSCALE_HOSTNAME=family-photos
TAILSCALE_IMAGE=tailscale/tailscale:v1.102.5

# Integrity cycle. Keep the private key outside Git and outside the gateway.
MANIFEST_SIGNING_KEY_ID=
MANIFEST_KEY_HOST_PATH=./.data/secrets/manifest-ed25519.pem
MANIFEST_PUBLIC_KEY_HOST_PATH=./.data/secrets/manifest-ed25519-public.pem
# Immutable public-key history; each file is <MANIFEST_SIGNING_KEY_ID>.pem.
MANIFEST_PUBLIC_KEYRING_HOST_PATH=./.data/secrets/manifest-public-keyring
# Keep this tiny sha256sum file outside the restic repository/restore target.
MANIFEST_TRUST_FINGERPRINTS_FILE=
MANIFEST_OUTPUT_DIR=./.data/manifests
INTEGRITY_REPORT_DIR=./.data/integrity-reports

# Private loopback metrics exporter.
METRICS_DEV_PORT=9091

# Append-only audit export staging. Copy or back this up off-host.
AUDIT_EXPORT_DIR=./.data/audit

# Encrypted off-site backups (host-side restic; leave unset until configured).
RESTIC_REPOSITORY=
RESTIC_PASSWORD_FILE=
RESTIC_READ_DATA_SUBSET=1/100
BACKUP_WORK_DIR=./.data/backup-work
# Host directory holding staging, quarantine and originals (one filesystem).
# Production: the mounted, encrypted media volume, e.g. /srv/family-photo/media.
# Empty uses ./.data/media for local development. Used by Compose and backups.
PHOTO_MEDIA_HOST_ROOT=
# Optional isolated restore destination/snapshot selection.
RESTORE_DRILL_DIR=
RESTORE_SNAPSHOT=latest

# Dedicated synthetic-probe account. Keep its password in an ignored file.
PROBE_BASE_URL=
PROBE_EMAIL=
PROBE_PASSWORD_FILE=

# Alert email (`make alert-email`, then `make alert-test`). The SMTP password is
# prompted for and stored outside .env. For Gmail use smtp.gmail.com:587 with an
# app password; any provider's authenticated submission port (587) works.
ALERT_EMAIL_TO=
ALERT_EMAIL_FROM=
ALERT_SMTP_SMARTHOST=
ALERT_SMTP_USERNAME=
ALERT_SMTP_REQUIRE_TLS=true
# Set by `make alert-email`; empty keeps the committed local-only receiver.
ALERTMANAGER_CONFIG_DIR=
# Where scripts/backup-restic.sh records its last checked success.
BACKUP_STATUS_DIR=./.data/backup-status

# Private observability stack. Admin UIs remain loopback-only.
PROMETHEUS_IMAGE=prom/prometheus:v3.13.4
ALERTMANAGER_IMAGE=prom/alertmanager:v0.34.1
GRAFANA_IMAGE=grafana/grafana:12.4.12
PROMETHEUS_DEV_PORT=9092
ALERTMANAGER_DEV_PORT=9093
GRAFANA_DEV_PORT=3000
GRAFANA_ADMIN_PASSWORD_FILE=./.data/secrets/grafana-admin-password
